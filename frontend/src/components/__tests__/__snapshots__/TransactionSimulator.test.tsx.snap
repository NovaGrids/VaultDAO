        <button
          class="min-h-[44px] flex-1 rounded-lg bg-gray-200 px-3 py-2 text-gray-800 hover:bg-gray-300 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600"
          type="button"
        >
          Simulate Again
