{
  "name": "vaultdao",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "ci": "npm run typecheck && npm run build && npm run contract:check && npm run backend:typecheck && npm run backend:build && npm run sdk:typecheck && npm run sdk:build && npm run sdk:test",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "contract:check": "cargo check --lib --manifest-path contracts/vault/Cargo.toml",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:test": "npm --prefix backend run test",
    "backend:lint": "npm --prefix backend run lint",
    "sdk:typecheck": "npm --prefix sdk run typecheck",
    "sdk:test": "npm --prefix sdk run test",
    "sdk:test:coverage": "npm --prefix sdk run test:coverage",
    "sdk:build": "npm --prefix sdk run build"
  }
}
